{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"buildCommand": "bash tools/vercel_build.sh",
	"installCommand": "echo 'no package manager: the build fetches Godot itself'",
	"outputDirectory": "build/web",
	"framework": null,
	"cleanUrls": false,
	"trailingSlash": false,
	"headers": [
		{
			"source": "/(.*)",
			"headers": [
				{
					"key": "Cross-Origin-Opener-Policy",
					"value": "same-origin"
				},
				{
					"key": "Cross-Origin-Embedder-Policy",
					"value": "require-corp"
				},
				{
					"key": "Cross-Origin-Resource-Policy",
					"value": "same-origin"
				},
				{
					"key": "X-Content-Type-Options",
					"value": "nosniff"
				}
			]
		},
		{
			"source": "/index.wasm",
			"headers": [
				{
					"key": "Content-Type",
					"value": "application/wasm"
				}
			]
		},
		{
			"source": "/index.pck",
			"headers": [
				{
					"key": "Content-Type",
					"value": "application/octet-stream"
				}
			]
		},
		{
			"source": "/index.html",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=0, must-revalidate"
				}
			]
		}
	]
}
